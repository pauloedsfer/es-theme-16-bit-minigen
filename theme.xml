<!--
	16-Bit-Minigen - an EmulationStation theme for 640x480 (4:3) handhelds: the R36S/R36XX on ArkOS
	A black console, cartridges for the systems, a wide list and the game's cover.
	All art is drawn by gen16.py; fonts: Orbitron and Exo 2 (SIL Open Font License, fonts/).
	Everything but each system's layout (layouts/) is in this one file: EmulationStation reads included files before
	a file's own views, so what the layouts set (the background, the list's and the cover's places) is not set here.
-->
<theme>
	<formatVersion>3</formatVersion>

	<!-- each system's layout (layouts/): the cover upright (portrait.xml) or lying (landscape.xml: the SNES, the N64...);
	     the background, the list's and the cover's places are there, everything else is here -->
	<include>./layouts/${system.theme}.xml</include>

	<!-- ===================== systems ===================== -->
	<view name="system">
		<image name="background" extra="true">
			<path>./art/bg_system.png</path>
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.155</pos>
			<size>1 0.66</size>
			<color>00000000</color>
			<logoSize>0.3 0.58</logoSize>
			<logoScale>1.15</logoScale>
			<maxLogoCount>3</maxLogoCount>
			<zIndex>40</zIndex>
		</carousel>
		<image name="logo">
			<path>./carts/${system.theme}.png</path>
			<default>./carts/default.png</default>
		</image>
		<text name="logoText">
			<fontPath>./fonts/Orbitron-Black.ttf</fontPath>
			<fontSize>0.05</fontSize>
			<color>FFFFFF</color>
			<forceUppercase>1</forceUppercase>
		</text>
		<text name="systemInfo">
			<pos>0.09 0.86</pos>
			<size>0.82 0.0833</size>
			<fontPath>./fonts/Orbitron-Bold.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<color>1A1A22</color>
			<backgroundColor>00000000</backgroundColor>
			<alignment>center</alignment>
			<forceUppercase>1</forceUppercase>
			<zIndex>50</zIndex>
		</text>
		<helpsystem name="help">
			<pos>2 2</pos>
		</helpsystem>
	</view>

	<!-- ===================== game lists ===================== -->
	<view name="basic, detailed, video">
		<image name="background" extra="true">
			<pos>0 0</pos>
			<origin>0 0</origin>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="header" extra="true">
			<path>./headers/${system.theme}.png</path>
			<default>./headers/default.png</default>
			<pos>0.5 0.0917</pos>
			<origin>0.5 0.5</origin>
			<maxSize>0.42 0.0667</maxSize>
			<zIndex>10</zIndex>
		</image>

		<textlist name="gamelist">
			<fontPath>./fonts/Exo2-SemiBold.ttf</fontPath>
			<fontSize>0.045</fontSize>
			<lineSpacing>1.5</lineSpacing>
			<alignment>left</alignment>
			<horizontalMargin>0.0156</horizontalMargin>
			<forceUppercase>0</forceUppercase>
			<selectorHeight>0.0667</selectorHeight>
			<selectorOffsetY>0</selectorOffsetY>
			<selectorColor>1D4FC4</selectorColor>
			<selectedColor>FFFFFF</selectedColor>
			<primaryColor>C9CCD3</primaryColor>
			<secondaryColor>FFC72C</secondaryColor>
			<zIndex>20</zIndex>
		</textlist>

		<!-- the cover alone -->
		<image name="md_image">
			<origin>0.5 0.5</origin>
			<default>./nocover/${system.theme}.png</default>
			<zIndex>30</zIndex>
		</image>

		<!-- the bottom bar: genre, year, players -->
		<text name="md_genre">
			<pos>0.0969 0.8708</pos>
			<size>0.5 0.0667</size>
			<fontPath>./fonts/Exo2-ExtraBold.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<alignment>left</alignment>
			<forceUppercase>1</forceUppercase>
			<color>1A1A22</color>
			<zIndex>40</zIndex>
		</text>
		<datetime name="md_releasedate">
			<pos>0.62 0.8708</pos>
			<size>0.22 0.0667</size>
			<fontPath>./fonts/Orbitron-Black.ttf</fontPath>
			<fontSize>0.04</fontSize>
			<alignment>right</alignment>
			<format>%Y</format>
			<color>1D4FC4</color>
			<zIndex>40</zIndex>
		</datetime>
		<text name="md_players">
			<pos>0.8625 0.8583</pos>
			<size>0.0531 0.0812</size>
			<fontPath>./fonts/Orbitron-Black.ttf</fontPath>
			<fontSize>0.05</fontSize>
			<alignment>center</alignment>
			<color>FFFFFF</color>
			<zIndex>40</zIndex>
		</text>

		<helpsystem name="help">
			<pos>2 2</pos>
		</helpsystem>

		<!-- the rest of EmulationStation's detailed view, off screen -->
		<text name="md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_description, md_developer, md_publisher, md_playcount, md_name">
			<pos>2 2</pos>
		</text>
		<rating name="md_rating">
			<pos>2 2</pos>
		</rating>
		<!-- the system's name as EmulationStation writes it over the header: ours is the header image -->
		<text name="logoText">
			<pos>2 2</pos>
		</text>
		<image name="logo">
			<pos>2 2</pos>
		</image>
		<datetime name="md_lastplayed">
			<pos>2 2</pos>
		</datetime>
		<image name="md_marquee, md_thumbnail, md_fanart">
			<pos>2 2</pos>
		</image>
	</view>

	<!-- systems with videos: the cover, not the video -->
	<view name="video">
		<video name="md_video">
			<pos>2 2</pos>
			<size>0.01 0.01</size>
			<showSnapshotNoVideo>false</showSnapshotNoVideo>
		</video>
	</view>
</theme>
